# Server Configuration
PORT=8000
CLIENT_URL=http://localhost:5173

# MongoDB Connection String (Local MongoDB or MongoDB Atlas)
MONGODB_URL=mongodb://localhost:27017/virtual-assistant

# JWT Authentication Secret Key
JWT_SECRET=your_jwt_secret_key_here

# Cloudinary Credentials (For Assistant Avatar Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Google Gemini API
# Option 1: Direct Gemini API key (recommended)
GEMINI_API_KEY=your_gemini_api_key_here

# Option 2: Full Gemini API URL (as taught in the tutorial)
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=your_gemini_api_key_here
